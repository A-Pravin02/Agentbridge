# Dependencies
node_modules/

# Build output
dist/
.next/
out/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Prisma — patterns containing a slash are anchored to the repo root, so the
# previous `prisma/*.db` never matched apps/api/prisma/dev.db and the database
# was committed. Un-anchored patterns match at any depth.
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
*.log
npm-debug.log*

# Testing
coverage/

# Misc
*.tsbuildinfo

# Demo agent private key (generated by the seed)
.demo-agent.json

# Generated working copy — the real migrations live in
# prisma/migrations-sqlite and prisma/migrations-postgres.
apps/api/prisma/migrations/
