# ============================================
# AgentBridge Environment
# ============================================
# Copy to .env and fill in. NEVER commit .env.
#
# Secrets have NO insecure defaults. In development an ephemeral value is
# generated per boot; in production the process refuses to start without them.

NODE_ENV="development"

# ---- Database ----
# SQLite by default: zero setup, `npm run setup` and you are running.
DATABASE_URL="file:./dev.db"
#
# PostgreSQL (deployment). Switch the schema target FIRST:
#   npm run db:use:postgres
# then set:
# DATABASE_URL="postgresql://user:password@host:5432/agentbridge?sslmode=require"

# ---- API ----
API_PORT=3001
API_HOST="127.0.0.1"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
LOG_LEVEL="info"

# ---- Secrets (min 32 chars; generate with: openssl rand -hex 32) ----
SESSION_SECRET=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Payments ----
# "sandbox" = local provider, no network. Signature VERIFICATION is identical
# in both modes; only the counterparty that mints signatures changes.
# "razorpay" = live Razorpay test-mode API.
PAYMENT_MODE="sandbox"
RAZORPAY_KEY_ID="rzp_test_sandbox"

# ---- Limits ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
REQUEST_SKEW_MS=300000
AUTHORIZATION_TTL_MS=900000
APPROVAL_TTL_MS=600000

# ---- Demo ----
# Must be false in production; the config loader enforces this.
ENABLE_DEMO_ROUTES="true"
DEMO_APPROVER_PASSWORD="techkart-demo-2026"

# ---- Frontend ----
# Local development. In production this is the deployed API origin, and it must
# also appear in the API's own ALLOWED_ORIGINS or the browser will be blocked.
NEXT_PUBLIC_API_URL="http://localhost:3001"
