{
  "name": "agentbridge",
  "version": "0.1.0",
  "private": true,
  "description": "The Authorization Layer for AI Commerce",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript/typescript-win32-x64": "^7.0.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1"
  }
}
